# ===================================================================
# ToolKit - Firebase Configuration Template (.env.example)
# ===================================================================
# Sao chép file này thành .env và điền các giá trị từ Firebase Console:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ===================================================================

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ===================================================================
# AI backend URL. Keep the Gemini API key only on this backend, never in the app.
# ===================================================================
EXPO_PUBLIC_GEMINI_API_URL=https://your-ai-backend.example.com/gemini
EXPO_PUBLIC_SNAP_SERVER_URL=https://your-snap-server.example.com
